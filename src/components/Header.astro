---
const { activeItemID } = Astro.props;
---

<header
  class="sticky top-0 z-30 w-full bg-base-100/90 backdrop-blur border-b border-base-300"
>
  <div class="navbar mx-auto max-w-[900px] px-4 min-h-[4rem]">
    <div class="navbar-start">
      <a href="/" class="flex items-center gap-3">
        <img src="/profile.webp" width="36" height="36" class="w-9 h-9 rounded-full" alt="프로필" />
        <span class="text-lg font-bold font-pixel">김지우 🐢</span>
      </a>
    </div>
    <div class="navbar-end">
      <ul class="menu menu-horizontal font-pixel gap-1 px-0">
        <li><a id="home" href="/">Home</a></li>
        <li><a id="blog" href="/blog/">Blog</a></li>
        <li>
          <a
            href="mailto:kingcheee1101@gmail.com"
            referrerpolicy="no-referrer-when-downgrade">Contact</a
          >
        </li>
      </ul>
    </div>
  </div>
</header>

<script define:vars={{ activeItemID }}>
const el = activeItemID && document.getElementById(activeItemID);
el && el.classList.add("text-primary", "font-bold");
</script>
