---
// 글 갈래 탭 — 회고(기본) / 일기 / 생각.
// 회고는 /blog/ 자체가 회고 목록이라 그쪽을 가리키고, 나머지 둘은 태그 페이지를 쓴다.
const { active } = Astro.props;

const categories = [
  { name: "회고", href: "/blog/" },
  { name: "일기", href: "/blog/tag/일기/" },
  { name: "생각", href: "/blog/tag/생각/" },
];
---

<div role="tablist" class="tabs tabs-bordered font-pixel mb-6">
  {
    categories.map((c) => (
      <a
        role="tab"
        href={c.href}
        class={"tab text-base" + (c.name === active ? " tab-active text-primary" : "")}
      >
        {c.name}
      </a>
    ))
  }
</div>
