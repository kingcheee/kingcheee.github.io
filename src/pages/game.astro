---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Turtle Stack" sideBarActiveItemID="game">
  <div id="gameWrap">
    <canvas id="cv" width="180" height="320"></canvas>
  </div>
  <div id="nameUi">
    <div id="nameBox">
      <p>TOP 4!</p>
      <input id="nameInput" maxlength="8" placeholder="NAME" autocomplete="off" enterkeyhint="done" />
      <button id="nameOk">OK</button>
    </div>
  </div>
</BaseLayout>

<style is:global>
  /* 게임 페이지 전용: 푸터를 내리고 스크롤 없이 화면에 꽉 차게.
     DaisyUI .footer(명시도 0-1-0)를 이기려면 footer.footer(0-1-1)여야 한다 */
  footer.footer { display: none; }
</style>

<style>
  #gameWrap {
    display: flex;
    justify-content: center;
    align-items: flex-start;
  }
  canvas {
    display: block;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }
  #nameUi {
    position: fixed; inset: 0; display: none;
    align-items: center; justify-content: center;
    background: rgba(35, 40, 30, 0.35); z-index: 40;
  }
  #nameBox {
    background: #f7f6f0; border: 3px solid #23281e;
    padding: 14px 18px; text-align: center;
    font-family: ui-monospace, monospace;
  }
  #nameBox p { margin: 0 0 10px; font-weight: bold; color: #23281e; font-size: 15px; }
  #nameInput {
    width: 130px; font: bold 16px ui-monospace, monospace; text-transform: uppercase;
    text-align: center; border: 2px solid #23281e; background: #fefdfa;
    color: #23281e; padding: 4px; outline: none;
  }
  #nameOk {
    margin: 10px auto 0; display: block; font: bold 13px ui-monospace, monospace;
    background: #2f8a25; color: #ffffff; border: 2px solid #23281e;
    padding: 4px 16px; cursor: pointer;
  }
</style>

<script is:inline data-astro-rerun>
// Turtle Stack — 단일 캔버스 미니게임.
// ViewTransitions 환경: 이 스크립트는 페이지 재방문마다 다시 실행되고(data-astro-rerun),
// 떠날 때 astro:before-swap에서 리스너·루프를 정리한다. 전역 오염 방지로 IIFE.
(() => {
const cv = document.getElementById('cv');
const wrap = document.getElementById('gameWrap');
const ctx = cv.getContext('2d');
const nameUi = document.getElementById('nameUi');
const nameInput = document.getElementById('nameInput');
const nameOk = document.getElementById('nameOk');

const W = 180, H = 320;   // 논리 해상도 — 게임 좌표계는 전부 이 단위
const LH = 14;            // 층 높이
const W0 = 64;            // 시작 슬래브 폭
const PERFECT = 2;        // 퍼펙트 허용 오차(논리 px, 중심 기준)
const GAP = 54;           // 슬라이드 위치: 탑 꼭대기에서 위로
const CAM_BASE = -(H - 46);
const C = {
  bg: '#FEFDFA', panel: '#F7F6F0', line: '#EAEAE2', ink: '#23281E',
  green: '#2F8A25', bright: '#55B93E', pale: '#EAF6E4',
  red: '#C4442A', yellow: '#D9A520',
};

// ── 수명 관리 (ViewTransitions 대응) ──────────────────────
const ac = new AbortController();
let dead = false;
document.addEventListener('astro:before-swap', () => {
  dead = true;
  ac.abort();
  document.body.style.background = '';   // 밤 테마가 다른 페이지로 새지 않게
}, { once: true });
const on = (target, ev, fn, opts) =>
  target.addEventListener(ev, fn, Object.assign({ signal: ac.signal }, opts));

// ── 밤 테마 (10층마다 낮/밤 교대) ─────────────────────────
const NIGHT = { bg: '#23281E', ui: '#FEFDFA', line: '#3A4033', panel: '#2E3428' };
let nightMix = 0;                    // 0 = 낮, 1 = 밤 (부드럽게 전환)
const T = { bg: C.bg, ui: C.ink, line: C.line, panel: C.panel };
const hex2 = h => [parseInt(h.slice(1, 3), 16), parseInt(h.slice(3, 5), 16), parseInt(h.slice(5, 7), 16)];
function mixC(a, b, t) {
  const A = hex2(a), B = hex2(b);
  return 'rgb(' + Math.round(A[0] + (B[0] - A[0]) * t) + ',' +
                  Math.round(A[1] + (B[1] - A[1]) * t) + ',' +
                  Math.round(A[2] + (B[2] - A[2]) * t) + ')';
}
function themeUpdate() {
  T.bg = mixC(C.bg, NIGHT.bg, nightMix);
  T.ui = mixC(C.ink, NIGHT.ui, nightMix);
  T.line = mixC(C.line, NIGHT.line, nightMix);
  T.panel = mixC(C.panel, NIGHT.panel, nightMix);
  document.body.style.background = T.bg;  // 캔버스 밖 여백도 테마를 따라간다
}

// ── 화면 맞춤: 헤더 아래 남은 공간에 맞추고, 캔버스는 디바이스 해상도로 ──
function fit() {
  // wrap 너비는 캔버스 크기를 따라가므로(콘텐츠 크기 main) 기준으로 쓰면 순환 참조가 된다
  const availW = Math.min(innerWidth - 24, 440);
  const availH = Math.max(240, innerHeight - wrap.getBoundingClientRect().top - 16);
  const s = Math.max(0.5, Math.min(availW / W, availH / H));
  const dpr = window.devicePixelRatio || 1;
  cv.style.width = Math.floor(W * s) + 'px';
  cv.style.height = Math.floor(H * s) + 'px';
  cv.width = Math.round(W * s * dpr);
  cv.height = Math.round(H * s * dpr);
}
on(window, 'resize', fit);
fit();

// ── 사운드 (WebAudio 합성, 첫 입력 후에만) ─────────────────
let AC = null;
function initAudio() {
  try {
    if (!AC) AC = new (window.AudioContext || window.webkitAudioContext)();
    if (AC.state === 'suspended') AC.resume();
  } catch (e) { AC = null; }
}
function beep(f, dur, vol, fEnd) {
  if (!AC) return;
  try {
    const o = AC.createOscillator(), g = AC.createGain();
    o.type = 'square';
    o.frequency.setValueAtTime(f, AC.currentTime);
    if (fEnd) o.frequency.exponentialRampToValueAtTime(fEnd, AC.currentTime + dur);
    g.gain.setValueAtTime(vol, AC.currentTime);
    g.gain.exponentialRampToValueAtTime(0.0001, AC.currentTime + dur);
    o.connect(g); g.connect(AC.destination);
    o.start(); o.stop(AC.currentTime + dur);
  } catch (e) {}
}
const snd = {
  drop:    () => beep(150, 0.05, 0.035),
  slice:   () => beep(95, 0.08, 0.045, 60),
  perfect: (k) => beep(620 + k * 40, 0.09, 0.04, 900),
  over:    () => beep(220, 0.35, 0.045, 70),
};

// ── 리더보드 (TOP 4, localStorage) ────────────────────────
let board = [];
try {
  const raw = localStorage.getItem('turtle-stack-board');
  if (raw) board = JSON.parse(raw).filter(e => e && typeof e.s === 'number' && typeof e.n === 'string').slice(0, 4);
} catch (e) {}
if (!board.length) {
  // 옛 단일 최고기록에서 이관
  try {
    const old = +localStorage.getItem('turtle-stack-best') || 0;
    if (old > 0) board = [{ n: '---', s: old }];
  } catch (e) {}
}
let best = board.length ? board[0].s : 0;
let nameActive = false, pendingScore = 0, lastEntry = null;

function submitName() {
  if (!nameActive) return;
  const nm = nameInput.value.trim().toUpperCase().slice(0, 8) || '---';
  lastEntry = { n: nm, s: pendingScore };
  board.push(lastEntry);
  board.sort((a, b) => b.s - a.s);
  board = board.slice(0, 4);
  best = board[0].s;
  try { localStorage.setItem('turtle-stack-board', JSON.stringify(board)); } catch (e) {}
  nameActive = false;
  nameUi.style.display = 'none';
  nameInput.blur();
}
on(nameOk, 'click', submitName);
on(nameInput, 'keydown', (e) => {
  e.stopPropagation();               // 게임 키 입력과 분리 (Space로 재시작되는 것 방지)
  if (e.key === 'Enter') submitName();
});

// ── 상태 ─────────────────────────────────────────────────
let state, layers, slab, pieces, fxs, clouds, nextCloudY;
let camY, camTarget, shakeT, shakeMag, streak, overAt, newBest;

function reset() {
  state = 'start';
  layers = [{ x: (W - W0) / 2, w: W0, y: 0 }];  // y = 층 윗변, 위로 갈수록 음수
  slab = null;
  pieces = []; fxs = []; clouds = [];
  camY = CAM_BASE; camTarget = CAM_BASE;
  shakeT = 0; shakeMag = 0; streak = 0; overAt = 0; newBest = false;
  lastEntry = null;
  nextCloudY = -20;
  ensureClouds();
}

function score() { return layers.length - 1; }

function spawnSlab(w) {
  const n = layers.length;
  const fromLeft = n % 2 === 1;   // 층마다 반대쪽에서 출발
  slab = {
    w, x: fromLeft ? -w - 6 : W + 6,
    y: -n * LH - GAP,
    dir: fromLeft ? 1 : -1,
    spd: Math.min(210, 85 + n * 2.5),
    mode: 'slide', vy: 0,
  };
}

// ── 입력: keydown/pointerdown에서 즉시 발동 ────────────────
function press() {
  if (nameActive) return;            // 이름 입력 중에는 게임 입력 무시
  if (state === 'start') {
    state = 'playing';
    spawnSlab(W0);
  } else if (state === 'playing') {
    if (slab && slab.mode === 'slide') {
      slab.mode = 'fall';
      slab.vy = 150;
      snd.drop();
    }
  } else if (state === 'over') {
    if (performance.now() - overAt > 500) {  // 죽인 입력이 바로 재시작하는 것 방지
      reset();
      state = 'playing';
      spawnSlab(W0);
    }
  }
}
on(window, 'keydown', (e) => {
  if (nameActive) return;
  if (e.code === 'Space') {
    e.preventDefault();
    if (!e.repeat) { initAudio(); press(); }  // 꾹 눌러도 연속 드랍 없음
  } else if (e.code === 'KeyF' && !e.repeat) {
    showFps = !showFps;                       // FPS 카운터 토글
  }
});
// 헤더·다른 링크를 막지 않게 게임 영역에만 건다
on(wrap, 'pointerdown', (e) => {
  if (nameActive) return;
  e.preventDefault();
  initAudio(); press();
});

// ── 착지 판정 ─────────────────────────────────────────────
function land() {
  const top = layers[layers.length - 1];
  const yTop = -layers.length * LH;
  const L = Math.max(slab.x, top.x);
  const R = Math.min(slab.x + slab.w, top.x + top.w);

  if (R - L < 1) {  // 완전 빗나감
    pieces.push({ x: slab.x, y: yTop, w: slab.w, vx: slab.dir * 15, vy: slab.vy });
    slab = null;
    gameOver();
    return;
  }

  const dCenter = (slab.x + slab.w / 2) - (top.x + top.w / 2);
  if (Math.abs(dCenter) <= PERFECT) {
    // 퍼펙트: 자르지 않고 정렬. 연속 퍼펙트면 폭이 회복된다.
    streak++;
    let w = slab.w;
    if (streak >= 2) w = Math.min(W0, w + 4);
    const x = Math.round(top.x + top.w / 2 - w / 2);
    layers.push({ x, w, y: yTop });
    fxs.push({ type: 'ring', x, y: yTop, w, t: 0 });
    fxs.push({ type: 'text', str: 'PERFECT!' + (streak >= 2 ? ' x' + streak : ''),
               x: x + w / 2, y: yTop - 6, t: 0, color: C.green });
    snd.perfect(streak);
  } else {
    // 슬라이스: 걸친 부분만 남기고 튀어나온 쪽은 떨어져 나간다
    if (slab.x < L - 0.5)
      pieces.push({ x: slab.x, y: yTop, w: Math.round(L - slab.x), vx: -22, vy: 40 });
    if (slab.x + slab.w > R + 0.5)
      pieces.push({ x: Math.round(R), y: yTop, w: Math.round(slab.x + slab.w - R), vx: 22, vy: 40 });
    layers.push({ x: Math.round(L), w: Math.round(R - L), y: yTop });
    streak = 0;
    shakeT = 0.09; shakeMag = 0.4;
    snd.slice();
  }
  slab = null;
  spawnSlab(layers[layers.length - 1].w);
}

function gameOver() {
  state = 'over';
  overAt = performance.now();
  shakeT = 0.3; shakeMag = 3;
  const s = score();
  newBest = s > best;
  // TOP 4 진입 시 이름 입력 (죽음 연출이 지나간 뒤에 띄운다)
  if (s > 0 && (board.length < 4 || s > board[board.length - 1].s)) {
    pendingScore = s;
    setTimeout(() => {
      if (dead || state !== 'over') return;
      nameActive = true;
      nameUi.style.display = 'flex';
      nameInput.value = '';
      nameInput.focus();
    }, 450);
  }
  snd.over();
}

// ── 구름 ─────────────────────────────────────────────────
const CLOUD_P = 0.55;  // 패럴랙스 계수
function ensureClouds() {
  while (nextCloudY > camY * CLOUD_P - 40) {
    clouds.push({ x: Math.random() * (W - 40), y: nextCloudY, w: 18 + Math.random() * 22 });
    nextCloudY -= 34 + Math.random() * 40;
  }
  for (let i = clouds.length - 1; i >= 0; i--) {
    if (clouds[i].y - camY * CLOUD_P > H + 30) clouds.splice(i, 1);
  }
}

// ── 업데이트 ──────────────────────────────────────────────
function update(dt) {
  const topY = -(layers.length - 1) * LH;
  camTarget = Math.min(CAM_BASE, topY - 190);
  camY += (camTarget - camY) * (1 - Math.exp(-6 * dt));  // 주사율 무관 감쇠
  ensureClouds();

  // 10층마다 낮/밤 교대
  const nightTarget = Math.floor(score() / 10) % 2;
  nightMix += (nightTarget - nightMix) * (1 - Math.exp(-3 * dt));

  if (shakeT > 0) shakeT -= dt;

  if (slab) {
    if (slab.mode === 'slide') {
      slab.x += slab.dir * slab.spd * dt;
      if (slab.x > W - slab.w + 14) { slab.x = W - slab.w + 14; slab.dir = -1; }
      if (slab.x < -14) { slab.x = -14; slab.dir = 1; }
    } else {  // fall
      slab.vy += 2600 * dt;
      slab.y += slab.vy * dt;
      const restY = -layers.length * LH;
      if (slab.y >= restY) { slab.y = restY; land(); }
    }
  }

  for (let i = pieces.length - 1; i >= 0; i--) {
    const p = pieces[i];
    p.vy += 900 * dt;
    p.y += p.vy * dt;
    p.x += p.vx * dt;
    if (p.y - camY > H + 30) pieces.splice(i, 1);
  }

  for (let i = fxs.length - 1; i >= 0; i--) {
    fxs[i].t += dt;
    if (fxs[i].t > 0.5) fxs.splice(i, 1);
  }
}

// ── 그리기 ────────────────────────────────────────────────
let shakeX = 0, shakeY = 0;

// 반올림 없음 — 논리 픽셀 단위로 끊으면 움직임이 계단식이 된다
function sy(wy) { return wy - camY + shakeY; }

function drawSlab(px, screenY, w, withHead, dir) {
  const x = px + shakeX, y = screenY;
  // 등딱지 외곽 (모서리 라운드)
  ctx.fillStyle = C.ink;
  ctx.fillRect(x + 1, y, w - 2, LH - 2);
  ctx.fillRect(x, y + 1, w, LH - 4);
  // 등딱지
  ctx.fillStyle = C.green;
  ctx.fillRect(x + 1, y + 1, w - 2, 9);
  // 윗면 하이라이트
  ctx.fillStyle = C.bright;
  ctx.fillRect(x + 2, y + 1, w - 4, 2);
  // 스쿠트(등껍질 판): 모서리 깎은 밝은 판 격자
  for (let i = x + 3; i <= x + w - 8; i += 7) {
    ctx.fillStyle = C.bright;
    ctx.fillRect(i, y + 4, 5, 5);
    ctx.fillStyle = C.green;
    ctx.fillRect(i, y + 4, 1, 1); ctx.fillRect(i + 4, y + 4, 1, 1);
    ctx.fillRect(i, y + 8, 1, 1); ctx.fillRect(i + 4, y + 8, 1, 1);
  }
  // 배 (플라스트론)
  ctx.fillStyle = C.pale;
  ctx.fillRect(x + 2, y + 10, w - 4, 2);
  // 다리: 외곽 있는 발
  const legs = w < 14 ? [x + (w >> 1) - 2] : [x + 2, x + w - 7];
  for (let i = x + 18; i < x + w - 14; i += 16) legs.push(i);
  for (const lx of legs) {
    ctx.fillStyle = C.ink;
    ctx.fillRect(lx, y + 11, 5, 3);
    ctx.fillStyle = C.green;
    ctx.fillRect(lx + 1, y + 12, 3, 2);
  }
  // 머리는 슬라이드 중에만 (탭하면 쏙 들어간다)
  if (withHead) {
    const hx = dir > 0 ? x + w - 1 : x - 7;
    ctx.fillStyle = C.ink;
    ctx.fillRect(hx + 1, y + 1, 6, 9);
    ctx.fillRect(hx, y + 2, 8, 7);
    ctx.fillStyle = C.bright;
    ctx.fillRect(hx + 1, y + 2, 6, 7);
    ctx.fillStyle = C.ink;
    const ex = dir > 0 ? hx + 5 : hx + 2;
    ctx.fillRect(ex, y + 4, 1, 2);                    // 눈
    ctx.fillRect(dir > 0 ? hx + 5 : hx + 1, y + 7, 2, 1);  // 입
  }
}

function drawWorldTurtle() {
  // 기단 = 세계 거북이. 등딱지 윗면이 layers[0]의 착지면 — 윗면은 평평하게 유지.
  const b = layers[0];
  const x = b.x + shakeX, y = sy(0), w = b.w;
  // 그림자
  ctx.fillStyle = T.line;
  ctx.fillRect(x - 10, y + 28, w + 24, 2);
  // 목
  ctx.fillStyle = C.bright;
  ctx.fillRect(x + w - 2, y + 8, 6, 7);
  // 등딱지 외곽 (모서리 라운드)
  ctx.fillStyle = C.ink;
  ctx.fillRect(x - 1, y, w + 2, 18);
  ctx.fillRect(x - 2, y + 1, w + 4, 16);
  ctx.fillStyle = C.green;
  ctx.fillRect(x - 1, y + 1, w + 2, 13);
  ctx.fillStyle = C.bright;
  ctx.fillRect(x, y + 1, w, 2);
  // 스쿠트 2단: 어긋난 격자
  for (let r = 0; r < 2; r++) {
    const yy = y + 4 + r * 5;
    for (let i = x + 3 + (r % 2) * 4; i <= x + w - 9; i += 8) {
      ctx.fillStyle = C.bright;
      ctx.fillRect(i, yy, 6, 4);
      ctx.fillStyle = C.green;
      ctx.fillRect(i, yy, 1, 1); ctx.fillRect(i + 5, yy, 1, 1);
      ctx.fillRect(i, yy + 3, 1, 1); ctx.fillRect(i + 5, yy + 3, 1, 1);
    }
  }
  // 배 (플라스트론) + 마디
  ctx.fillStyle = C.pale;
  ctx.fillRect(x - 1, y + 14, w + 2, 3);
  ctx.fillStyle = C.line;
  for (let i = x + 6; i < x + w - 4; i += 10) ctx.fillRect(i, y + 14, 1, 3);
  // 머리 (라운드 + 눈 + 미소)
  const hx = x + w + 2;
  ctx.fillStyle = C.ink;
  ctx.fillRect(hx + 1, y + 3, 10, 13);
  ctx.fillRect(hx, y + 4, 12, 11);
  ctx.fillStyle = C.bright;
  ctx.fillRect(hx + 2, y + 4, 8, 11);
  ctx.fillRect(hx + 1, y + 5, 10, 9);
  ctx.fillStyle = C.ink;
  ctx.fillRect(hx + 7, y + 7, 2, 2);      // 눈
  ctx.fillStyle = C.bg;
  ctx.fillRect(hx + 7, y + 7, 1, 1);      // 눈 반짝임
  ctx.fillStyle = C.ink;
  ctx.fillRect(hx + 7, y + 11, 3, 1);     // 미소
  ctx.fillRect(hx + 10, y + 10, 1, 1);
  // 지느러미 (라운드 + 외곽)
  for (const fx0 of [x + 4, x + w - 18]) {
    ctx.fillStyle = C.ink;
    ctx.fillRect(fx0 + 1, y + 17, 12, 8);
    ctx.fillRect(fx0, y + 18, 14, 6);
    ctx.fillStyle = C.bright;
    ctx.fillRect(fx0 + 1, y + 18, 12, 5);
    ctx.fillStyle = C.green;
    ctx.fillRect(fx0 + 3, y + 20, 8, 2);  // 발 주름
  }
  // 꼬리
  ctx.fillStyle = C.ink;
  ctx.fillRect(x - 8, y + 8, 6, 5);
  ctx.fillStyle = C.bright;
  ctx.fillRect(x - 7, y + 9, 5, 3);
}

function draw(now) {
  // 캔버스는 디바이스 해상도, 그리기는 논리 좌표 — 변환 한 번으로 처리
  ctx.setTransform(cv.width / W, 0, 0, cv.height / H, 0, 0);
  themeUpdate();

  // 흔들림
  if (shakeT > 0) {
    shakeX = (Math.random() * 2 - 1) * shakeMag;
    shakeY = (Math.random() * 2 - 1) * shakeMag;
  } else { shakeX = 0; shakeY = 0; }

  ctx.fillStyle = T.bg;
  ctx.fillRect(0, 0, W, H);

  // 별 (밤에만, 세계 좌표 고정 — 해시로 결정적 배치)
  if (nightMix > 0.02) {
    ctx.globalAlpha = nightMix;
    ctx.fillStyle = '#F7F6F0';
    const base = Math.floor((camY * CLOUD_P) / 20) - 1;
    for (let n = base; n < base + Math.ceil(H / 20) + 2; n++) {
      const h1 = Math.sin(n * 127.1) * 43758.5453, f1 = h1 - Math.floor(h1);
      const h2 = Math.sin(n * 311.7) * 12543.85, f2 = h2 - Math.floor(h2);
      const yy = n * 20 - camY * CLOUD_P + shakeY;
      ctx.fillRect(Math.floor(f1 * (W - 4)) + 2, yy, 1.2, 1.2);
      if (f2 > 0.4) ctx.fillRect(Math.floor(((f1 + f2) % 1) * (W - 4)) + 2, yy + 9, 1, 1);
    }
    // 달 (화면 왼쪽 위 고정)
    ctx.fillStyle = '#F7F6F0';
    ctx.fillRect(24, 33, 12, 6);
    ctx.fillRect(26, 31, 8, 10);
    ctx.fillStyle = T.line;
    ctx.fillRect(28, 35, 2, 2);
    ctx.fillRect(32, 38, 1, 1);
    ctx.globalAlpha = 1;
  }

  // 해 (느린 패럴랙스 — 올라갈수록 아래로 가라앉는다)
  const sunY = -213 - camY * 0.9 + shakeY;
  if (sunY > -10 && sunY < H + 10) {
    ctx.globalAlpha = 1 - nightMix;
    ctx.fillStyle = C.yellow;
    ctx.fillRect(W - 39 + shakeX, sunY - 3, 10, 6);
    ctx.fillRect(W - 37 + shakeX, sunY - 5, 6, 10);
    ctx.globalAlpha = 1;
  }

  // 구름
  for (const c of clouds) {
    const cy = c.y - camY * CLOUD_P + shakeY;
    if (cy < -12 || cy > H + 12) continue;
    const cx = c.x + shakeX, cw = Math.round(c.w);
    ctx.fillStyle = T.line;
    ctx.fillRect(cx, cy + 2, cw, 5);
    ctx.fillRect(cx + (cw * 0.25 | 0), cy, cw * 0.5 | 0, 4);
    ctx.fillStyle = T.panel;
    ctx.fillRect(cx + 1, cy + 3, cw - 2, 2);
  }

  // 시작 지면 (올라가면 화면 밖으로 사라진다)
  const gy = sy(30);
  if (gy < H) {
    ctx.fillStyle = T.panel;
    ctx.fillRect(0, gy, W, H - gy);
    ctx.fillStyle = T.line;
    ctx.fillRect(0, gy, W, 2);
  }

  // 탑 (보이는 층만)
  const first = Math.max(1, layers.length - Math.ceil(H / LH) - 4);
  for (let i = first; i < layers.length; i++) {
    drawSlab(layers[i].x, sy(layers[i].y), layers[i].w, false, 0);
  }
  drawWorldTurtle();

  // 잘려나간 조각
  for (const p of pieces) {
    const x = p.x + shakeX, y = sy(p.y);
    ctx.fillStyle = C.ink;
    ctx.fillRect(x, y, p.w, 10);
    if (p.w > 2) {
      ctx.fillStyle = C.green;
      ctx.fillRect(x + 1, y + 1, p.w - 2, 6);
      ctx.fillStyle = C.pale;
      ctx.fillRect(x + 1, y + 7, p.w - 2, 2);
    }
  }

  // 움직이는 슬래브
  if (slab) drawSlab(slab.x, sy(slab.y), slab.w, slab.mode === 'slide', slab.dir);

  // 이펙트
  for (const f of fxs) {
    const a = 1 - f.t / 0.5;
    ctx.globalAlpha = Math.max(0, a);
    if (f.type === 'ring') {
      const pad = f.t * 30;
      ctx.strokeStyle = C.bright;
      ctx.lineWidth = 1;
      ctx.strokeRect(Math.round(f.x) - pad + 0.5 + shakeX, sy(f.y) - pad + 0.5,
                     f.w + pad * 2, LH - 2 + pad * 2);
    } else {
      ctx.font = 'bold 9px monospace';
      ctx.textAlign = 'center';
      ctx.fillStyle = T.ui;
      ctx.fillText(f.str, Math.round(f.x) + 1 + shakeX, sy(f.y) - f.t * 20 + 1);
      ctx.fillStyle = f.color;
      ctx.fillText(f.str, Math.round(f.x) + shakeX, sy(f.y) - f.t * 20);
    }
  }
  ctx.globalAlpha = 1;

  if (showFps) {
    ctx.font = '7px monospace';
    ctx.textAlign = 'left';
    ctx.fillStyle = T.ui;
    ctx.fillText((fpsAvg | 0) + ' FPS', 4, H - 5);
  }

  const blink = Math.floor(now / 450) % 2 === 0;

  if (state === 'start') {
    ctx.textAlign = 'center';
    ctx.fillStyle = T.ui;
    ctx.font = 'bold 17px monospace';
    ctx.fillText('TURTLE STACK', W / 2, 92);
    ctx.font = '8px monospace';
    ctx.fillStyle = C.green;
    ctx.fillText('the overhang gets sliced off', W / 2, 110);
    // TOP 4
    if (board.length) {
      ctx.fillStyle = T.ui;
      ctx.font = 'bold 8px monospace';
      ctx.fillText('TOP 4', W / 2, 130);
      ctx.font = '8px monospace';
      board.forEach((e, i) => {
        const yy = 143 + i * 11;
        ctx.textAlign = 'left';
        ctx.fillText((i + 1) + ' ' + e.n, 46, yy);
        ctx.textAlign = 'right';
        ctx.fillText(String(e.s), 134, yy);
        ctx.textAlign = 'center';
      });
    }
    if (blink) {
      ctx.font = '9px monospace';
      ctx.fillStyle = T.ui;
      ctx.fillText('SPACE / TAP TO START', W / 2, H - 88);
    }
  } else {
    // 점수
    ctx.textAlign = 'center';
    ctx.fillStyle = T.ui;
    ctx.font = 'bold 16px monospace';
    ctx.fillText(String(score()), W / 2, 26);
    ctx.font = '8px monospace';
    ctx.textAlign = 'right';
    ctx.fillText('BEST ' + Math.max(best, score()), W - 6, 12);
  }

  if (state === 'over' && !nameActive && performance.now() - overAt > 350) {
    ctx.fillStyle = C.ink;
    ctx.fillRect(14, 86, 152, 130);
    ctx.fillStyle = C.panel;
    ctx.fillRect(16, 88, 148, 126);
    ctx.textAlign = 'center';
    ctx.fillStyle = C.ink;
    ctx.font = 'bold 13px monospace';
    ctx.fillText('GAME OVER', W / 2, 106);
    ctx.fillStyle = C.green;
    ctx.font = 'bold 20px monospace';
    ctx.fillText(String(score()), W / 2, 130);
    if (newBest) {
      ctx.fillStyle = C.red;
      ctx.font = '8px monospace';
      ctx.fillText('NEW BEST!', W / 2, 142);
    }
    // TOP 4 (내 기록은 초록으로)
    ctx.font = '8px monospace';
    board.forEach((e, i) => {
      const yy = 156 + i * 11;
      ctx.fillStyle = e === lastEntry ? C.green : C.ink;
      ctx.textAlign = 'left';
      ctx.fillText((i + 1) + ' ' + e.n, 34, yy);
      ctx.textAlign = 'right';
      ctx.fillText(String(e.s), 146, yy);
    });
    if (blink && performance.now() - overAt > 500) {
      ctx.textAlign = 'center';
      ctx.fillStyle = C.ink;
      ctx.fillText('SPACE / TAP TO RESTART', W / 2, 208);
    }
  }
}

// ── 루프 ─────────────────────────────────────────────────
let last = performance.now();
let showFps = false, fpsAvg = 0;
function frame(now) {
  if (dead) return;                         // 페이지를 떠나면 루프 종료
  const rawMs = now - last;
  const dt = Math.min(0.05, rawMs / 1000);  // 탭 복귀 시 순간이동 방지
  last = now;
  if (rawMs > 0) fpsAvg += (1000 / rawMs - fpsAvg) * 0.08;
  update(dt);
  draw(now);
  requestAnimationFrame(frame);
}
reset();
requestAnimationFrame(frame);
})();
</script>
