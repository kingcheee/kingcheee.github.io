  if (S.state !== 'play') return true;
  if (paused) { setPaused(false); return true; }
  return false;
}

function inputNumber(n) {
  if (blocked()) return;
  closeHint();
  if (sel < 0 || !editable(sel)) return;
  if (notesMode) { toggleNote(sel, n); return; }
  if (digitDone(n) && S.val[sel] !== n) return;
  const i = sel, prev = S.val[i], prevNotes = S.notes[i];
  const nv = prev === n ? 0 : n;                // 같은 숫자를 다시 누르면 지운다
  const near = nv ? clearNearNotes(i, nv) : [];
  undo.push({ i, val: prev, notes: prevNotes, near });
  S.val[i] = nv; S.notes[i] = 0;
  touch();
  if (nv) {
    if (nv !== S.sol[i]) {
      S.mistakes++;
      if (S.mistakes >= MAX_MIS) { render(); gameOver(); save(); return; }
    } else {
      const done = award(i, nv, false);
