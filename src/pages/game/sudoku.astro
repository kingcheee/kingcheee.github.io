  #sdk .sdk-hintarrow, #sdk .sdk-hintok { width: 40px; height: 40px; border-radius: 50%; border: 0; background: var(--ctl); display: flex; align-items: center; justify-content: center; cursor: pointer; padding: 0; }
  #sdk .sdk-hintarrow:disabled { opacity: .35; cursor: default; }
