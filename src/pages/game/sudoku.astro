}
function showOver() { $('sdkOver').hidden = false; }
function secondChance() {
  if (S.state !== 'over') return;
  S.mistakes = Math.max(0, S.mistakes - 1);       // 3/3 → 2/3, 무료·횟수 제한 없음
  S.state = 'play';
  S.lastCorrect = now();
  $('sdkOver').hidden = true;
  runTimer();
  render(); save();
}
function hideLayers() { $('sdkOver').hidden = true; $('sdkWin').hidden = true; }

// ── 승리 ──────────────────────────────────────────────────
function win(last) {
  S.state = 'won';
  stopTimer();
  closeHint();
  busy = true;
  const ms = Math.round(now());
  const diff = S.diff, score = S.score;
  const best = readBest();
  const prevBest = best[diff] || 0;
  const isBest = score > prevBest;
  if (isBest) { best[diff] = score; writeBest(best); }
  try { localStorage.removeItem(SAVE_KEY); } catch (e) {}
  sel = -1; render();
  // 마지막 셀에서 링(체비쇼프 거리) 단위로 퍼지며 판을 정리한다
  const c0 = last >= 0 ? last : 40;
  let maxD = 0;
  for (let j = 0; j < 81; j++) {
    const d = Math.max(Math.abs(RI[j] - RI[c0]), Math.abs(CI[j] - CI[c0]));
    maxD = Math.max(maxD, d);
    setTimeout(() => { if (!dead) cells[j].classList.add('clear'); }, d * 70);
  }
  setTimeout(() => {
    if (dead) return;
    for (const c of cells) c.classList.remove('clear');
    for (let j = 0; j < 81; j++) vEls[j].textContent = '';
    for (const ns of noteEls) for (const s of ns) s.textContent = '';
    busy = false;
    showWin(diff, ms, score, Math.max(score, prevBest), isBest);
  }, maxD * 70 + 600);
}

async function showWin(diff, ms, score, best, isBest) {
  $('sdkWinDiff').textContent = DIFF[diff].label;
  $('sdkWinTime').textContent = fmtClock(ms);
  $('sdkWinScore').textContent = score;
  $('sdkWinBest').textContent = best;
  $('sdkWinNote').textContent = isBest ? '최고 점수 갱신' : '';
  $('sdkWinTopWrap').hidden = diff !== 'hard';
  $('sdkWin').hidden = false;
  if (diff !== 'hard' || !TB) return;
  let list = await TB.top('sudoku');
  if (dead) return;
  renderTop($('sdkWinTop'), list);
  if (TB.qualifies(list, ms, 'sudoku')) {
    const name = await TB.askName('TOP 5! ' + TB.fmtTime(ms));
    if (dead) return;
    await TB.submit('sudoku', name, ms);
    list = await TB.top('sudoku');
    if (dead) return;
    renderTop($('sdkWinTop'), list, ms, name);
    renderTop($('sdkTop'), list, ms, name);
  }
}

function renderTop(ol, list, myMs, myName) {
  ol.innerHTML = '';
  if (!list || !list.length) {
    const li = document.createElement('li'); li.className = 'empty'; li.textContent = '아직 기록이 없습니다';
    ol.appendChild(li); return;
  }
  let marked = false;
  list.forEach((row, k) => {
    const li = document.createElement('li');
    if (!marked && myMs != null && row.value === myMs && row.name === myName) { li.className = 'me'; marked = true; }
    const rk = document.createElement('span'); rk.className = 'rk'; rk.textContent = k + 1;
    const nm = document.createElement('span'); nm.className = 'nm'; nm.textContent = row.name;
    const tm = document.createElement('span'); tm.className = 'tm'; tm.textContent = TB ? TB.fmtTime(row.value) : row.value;
    li.append(rk, nm, tm); ol.appendChild(li);
