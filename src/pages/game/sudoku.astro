<script is:inline data-astro-rerun>
// 스도쿠 — sudoku.com/ko 클래식 모드의 규칙·UI를 따라 만든 클론 (쉬움·어려움 두 난이도).
// 퍼즐은 클라이언트에서 만든다: 무작위 완성판 → 셀을 하나씩 지우며 해답 유일성 검사.
// ViewTransitions 환경: data-astro-rerun으로 재방문마다 다시 돌고, astro:before-swap에서 정리한다.
(() => {
const root = document.getElementById('sdk');
if (!root) return;
const $ = id => document.getElementById(id);

// ── 수명 관리 ─────────────────────────────────────────────
const ac = new AbortController();
let dead = false, tickId = 0;
const on = (t, ev, fn, opts) => t.addEventListener(ev, fn, Object.assign({ signal: ac.signal }, opts));
document.addEventListener('astro:before-swap', () => {
  try { save(); } catch (e) {}
  dead = true; ac.abort(); clearInterval(tickId);
}, { once: true });

const TB = window.TurtleBoard || null;

// ── 상수 (원본 번들 값) ───────────────────────────────────
const DIFF = {
  easy: { label: '쉬움', base: 50, min: 5, step: 5 },
  hard: { label: '어려움', base: 210, min: 21, step: 21 },
};
const SCORE_TIME = 5000;     // time: 5 (초)
const MAX_MIS = 3;           // COUNT_MISTAKES
const MAX_HINTS = 3;         // COUNT_HINTS
const SAVE_KEY = 'turtle-sudoku-save';
const BEST_KEY = 'turtle-sudoku-best';
const NOASK_KEY = 'turtle-sudoku-noask';

// ── 좌표 테이블 ───────────────────────────────────────────
const RI = new Uint8Array(81), CI = new Uint8Array(81), BI = new Uint8Array(81);
for (let i = 0; i < 81; i++) { RI[i] = (i / 9) | 0; CI[i] = i % 9; BI[i] = ((RI[i] / 3) | 0) * 3 + ((CI[i] / 3) | 0); }
const UNITS = [];      // 0-8 행, 9-17 열, 18-26 블록
for (let r = 0; r < 9; r++) { const u = []; for (let c = 0; c < 9; c++) u.push(r * 9 + c); UNITS.push(u); }
for (let c = 0; c < 9; c++) { const u = []; for (let r = 0; r < 9; r++) u.push(r * 9 + c); UNITS.push(u); }
for (let b = 0; b < 9; b++) { const u = []; const r0 = ((b / 3) | 0) * 3, c0 = (b % 3) * 3; for (let k = 0; k < 9; k++) u.push((r0 + ((k / 3) | 0)) * 9 + c0 + (k % 3)); UNITS.push(u); }
const UOF = [];        // 셀 → [행, 열, 블록] 유닛 번호
for (let i = 0; i < 81; i++) UOF.push([RI[i], 9 + CI[i], 18 + BI[i]]);
const PEERS = [];
for (let i = 0; i < 81; i++) {
  const s = new Set();
  for (const u of UOF[i]) for (const j of UNITS[u]) if (j !== i) s.add(j);
  PEERS.push([...s]);
}
const POP = new Uint8Array(1024);
for (let m = 1; m < 1024; m++) POP[m] = POP[m >> 1] + (m & 1);
const ALL = 0x3FE;     // 비트 1..9

const rnd = n => Math.floor(Math.random() * n);
function shuffle(a) { for (let i = a.length - 1; i > 0; i--) { const j = rnd(i + 1); const t = a[i]; a[i] = a[j]; a[j] = t; } return a; }

// ── 솔버: 해답 개수 세기 (MRV + 비트마스크) ───────────────
// banCell/banVal: 그 셀에 그 값을 금지한 채로 센다 — 지운 셀이 원래 값이 아닌 다른 해답을 갖는지 보는 데 쓴다.
function countSolutions(src, limit, banCell, banVal) {
  const g = Int8Array.from(src);
  const rm = new Uint16Array(9), cm = new Uint16Array(9), bm = new Uint16Array(9);
  const emp = [];
  for (let i = 0; i < 81; i++) {
    const v = g[i];
    if (v) { const m = 1 << v; rm[RI[i]] |= m; cm[CI[i]] |= m; bm[BI[i]] |= m; } else emp.push(i);
  }
  const n = emp.length;
  const ban = banCell >= 0 ? ~(1 << banVal) : -1;
  let count = 0;
  function rec(d) {
    if (d === n) { count++; return count >= limit; }
    let best = d, bm0 = 0, bc = 10;
    for (let k = d; k < n; k++) {
      const i = emp[k];
      let m = ~(rm[RI[i]] | cm[CI[i]] | bm[BI[i]]) & ALL;
      if (i === banCell) m &= ban;
      const c = POP[m];
      if (c < bc) { bc = c; best = k; bm0 = m; if (c <= 1) break; }
    }
    if (bc === 0) return false;
    const t = emp[d]; emp[d] = emp[best]; emp[best] = t;
    const i = emp[d], r = RI[i], c = CI[i], b = BI[i];
    let m = bm0;
    while (m) {
      const bit = m & -m; m ^= bit;
      rm[r] |= bit; cm[c] |= bit; bm[b] |= bit;
      if (rec(d + 1)) return true;
      rm[r] ^= bit; cm[c] ^= bit; bm[b] ^= bit;
    }
    return false;
  }
  rec(0);
  return count;
}

function fullGrid() {
  const g = new Int8Array(81);
  const rm = new Uint16Array(9), cm = new Uint16Array(9), bm = new Uint16Array(9);
  const digits = [1, 2, 3, 4, 5, 6, 7, 8, 9];
  function rec(i) {
    if (i === 81) return true;
    const r = RI[i], c = CI[i], b = BI[i];
    const used = rm[r] | cm[c] | bm[b];
    for (const v of shuffle(digits.slice())) {
      const bit = 1 << v;
      if (used & bit) continue;
      g[i] = v; rm[r] |= bit; cm[c] |= bit; bm[b] |= bit;
      if (rec(i + 1)) return true;
      rm[r] ^= bit; cm[c] ^= bit; bm[b] ^= bit; g[i] = 0;
    }
    return false;
  }
  rec(0);
  return g;
}

// 사람식 기초 기법(확실한 숫자·숨겨진 숫자)만으로 풀리는가 — 난이도 판정용
function singlesSolvable(src) {
  const g = Int8Array.from(src);
  for (;;) {
    let progress = false, empty = 0;
    const cand = new Uint16Array(81);
    for (let i = 0; i < 81; i++) {
      if (g[i]) continue;
      empty++;
      let m = ALL;
      for (const j of PEERS[i]) if (g[j]) m &= ~(1 << g[j]);
      if (!m) return false;
      cand[i] = m;
    }
    if (!empty) return true;
    for (let i = 0; i < 81; i++) {
      if (!g[i] && POP[cand[i]] === 1) { g[i] = 31 - Math.clz32(cand[i]); progress = true; }
    }
    if (progress) continue;
    for (let u = 0; u < 27 && !progress; u++) {
      for (let v = 1; v <= 9; v++) {
        const bit = 1 << v; let at = -1, cnt = 0, placed = false;
        for (const j of UNITS[u]) { if (g[j] === v) { placed = true; break; } if (!g[j] && (cand[j] & bit)) { cnt++; at = j; } }
        if (!placed && cnt === 1) { g[at] = v; progress = true; break; }
      }
    }
    if (!progress) return false;
  }
}

// 퍼즐 생성. 쉬움 36~40 단서(기초 기법으로 풀림), 어려움 24~27 단서(기초 기법만으로는 막힘).
// 시간 예산을 넘기면 그때까지 가장 나은 후보를 쓴다.
function generate(diff) {
  const t0 = performance.now();
  const BUDGET = 260;
  let best = null, bestScore = 1e9;
  for (let attempt = 0; ; attempt++) {
    const sol = fullGrid();
    const p = Int8Array.from(sol);
    const order = shuffle([...Array(81).keys()]);
    let clues = 81;
    if (diff === 'easy') {
      const target = 36 + rnd(5);
      for (const i of order) {
        if (clues <= target) break;
        const v = p[i]; p[i] = 0;
        if (countSolutions(p, 1, i, v) > 0) p[i] = v; else clues--;
      }
      const score = (singlesSolvable(p) ? 0 : 10) + Math.max(0, clues - 40);
      if (score < bestScore) { best = { p, sol, clues }; bestScore = score; }
    } else {
      const removed = [];
      for (const i of order) {
        const v = p[i]; p[i] = 0;
        if (countSolutions(p, 1, i, v) > 0) p[i] = v; else { clues--; removed.push(i); }
      }
      if (clues < 24) {                      // 너무 적으면 되살려 24로 (유일성은 유지된다)
        shuffle(removed);
        while (clues < 24) { const i = removed.pop(); p[i] = sol[i]; clues++; }
      }
      const score = (clues > 27 ? (clues - 27) * 3 : 0) + (singlesSolvable(p) ? 2 : 0);
      if (score < bestScore) { best = { p, sol, clues }; bestScore = score; }
    }
    if (bestScore === 0) break;
    if (performance.now() - t0 > BUDGET) break;
  }
  return { puzzle: Array.from(best.p), solution: Array.from(best.sol), clues: best.clues, ms: performance.now() - t0 };
}

// ── 게임 상태 ─────────────────────────────────────────────
let S = null;          // 저장 가능한 상태
let undo = [];         // 실행 취소 스택 (원본도 새로고침 후엔 비어 있다)
let sel = -1;
let notesMode = false;
let paused = false, autoPaused = false;
let acc = 0, runStart = null;   // 일시정지를 뺀 경과 시간
let hint = null;       // 열린 스마트 힌트 {target, value, steps, step, areas}
let busy = false;      // 승리 연출 중

const now = () => acc + (runStart !== null ? performance.now() - runStart : 0);
function runTimer() { if (runStart === null) runStart = performance.now(); }
function stopTimer() { if (runStart !== null) { acc += performance.now() - runStart; runStart = null; } }

function freshState(diff, gen) {
  return {
    v: 1, diff,
    puzzle: gen.puzzle, sol: gen.solution,
    val: gen.puzzle.slice(),
    lock: gen.puzzle.map(x => (x ? 1 : 0)),   // 1 = 주어진 숫자, 2 = 힌트로 채움 (둘 다 수정 불가)
    notes: new Array(81).fill(0),
    mistakes: 0, hints: MAX_HINTS, score: 0, scored: [],
    lastCorrect: 0, elapsed: 0, state: 'play', touched: false,
  };
}

function startNew(diff) {
  closeHint();
  const gen = generate(diff);
  S = freshState(diff, gen);
  undo = []; sel = -1; paused = false; autoPaused = false; busy = false;
  acc = 0; runStart = null; runTimer();
  root.classList.add('tipon');
  hideLayers();
  render(); save();
}

// 다시 시작 = 같은 난이도의 새 퍼즐 (원본은 같은 판을 처음부터지만, 사용자 요청으로 새 숫자를 뽑는다)
function restart() { startNew(S.diff); }

// ── 저장·불러오기 ─────────────────────────────────────────
function save() {
  if (!S) return;
  if (S.state === 'won') { try { localStorage.removeItem(SAVE_KEY); } catch (e) {} return; }
  S.elapsed = Math.round(now());
  try { localStorage.setItem(SAVE_KEY, JSON.stringify(S)); } catch (e) {}
}
function load() {
  try {
    const o = JSON.parse(localStorage.getItem(SAVE_KEY));
    if (!o || o.v !== 1 || !DIFF[o.diff] || !Array.isArray(o.val) || o.val.length !== 81 ||
        !Array.isArray(o.sol) || o.sol.length !== 81 || o.state === 'won') return null;
    return o;
  } catch (e) { return null; }
}
function readBest() { try { return JSON.parse(localStorage.getItem(BEST_KEY)) || {}; } catch (e) { return {}; } }
function writeBest(b) { try { localStorage.setItem(BEST_KEY, JSON.stringify(b)); } catch (e) {} }

// ── 보드 DOM ──────────────────────────────────────────────
const boardEl = $('sdkBoard');
const cells = [], vEls = [], noteEls = [];
for (let i = 0; i < 81; i++) {
  const d = document.createElement('div');
  let cls = 'c';
  const c = CI[i], r = RI[i];
  if (c === 2 || c === 5) cls += ' br';
  if (r === 2 || r === 5) cls += ' bb';
  if (c === 8) cls += ' er';
  if (r === 8) cls += ' eb';
  d.className = cls;
  d.dataset.i = i;
  const v = document.createElement('span'); v.className = 'v';
  const nt = document.createElement('div'); nt.className = 'nt';
  const ns = [];
  for (let k = 1; k <= 9; k++) { const s = document.createElement('span'); nt.appendChild(s); ns.push(s); }
  d.appendChild(v); d.appendChild(nt);
  boardEl.appendChild(d);
  cells.push(d); vEls.push(v); noteEls.push(ns);
}
