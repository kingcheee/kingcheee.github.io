  pendingDiff = d;
  $('sdkNoAsk').checked = false;
  $('sdkConfirm').hidden = false;
}
function closeDropdown() { $('sdkDiffMenu').hidden = true; }
const modalOpen = () => !$('sdkMenu').hidden || !$('sdkConfirm').hidden;

// ── 이벤트 연결 ───────────────────────────────────────────
on(boardEl, 'pointerdown', e => {
  const c = e.target.closest('.c');
  if (!c) return;
  e.preventDefault();
  select(+c.dataset.i);
});
on($('sdkPauseOv'), 'pointerdown', e => { e.preventDefault(); setPaused(false); });
on($('sdkPad'), 'pointerdown', e => {
  const b = e.target.closest('button[data-n]');
  if (!b) return;
  e.preventDefault();
  inputNumber(+b.dataset.n);
});
on(root.querySelector('.sdk-tools'), 'pointerdown', e => {
  const b = e.target.closest('.sdk-tool');
  if (!b) return;
  e.preventDefault();
  const a = b.dataset.act;
  if (a === 'undo') doUndo();
  else if (a === 'erase') erase();
  else if (a === 'notes') toggleNotes();
  else if (a === 'hint') useHint();
});
on($('sdkPause'), 'click', () => setPaused(!paused));
on($('sdkNewBtn'), 'click', () => openMenu(false));
on($('sdkMenuCancel'), 'click', closeMenu);
on($('sdkMenu'), 'click', e => {
  if (e.target === $('sdkMenu')) { closeMenu(); return; }
  const b = e.target.closest('.sdk-menu-item');
  if (!b) return;
  $('sdkMenu').hidden = true; menuFromOver = false;
  if (b.dataset.act === 'restart') restart(); else startNew(b.dataset.diff);
});
on($('sdkSecond'), 'click', secondChance);
on($('sdkOverNew'), 'click', () => openMenu(true));
on($('sdkWinNew'), 'click', () => openMenu(false));
for (const b of root.querySelectorAll('.sdk-diffbtn')) on(b, 'click', () => askDiff(b.dataset.diff));
on($('sdkDiffLabel'), 'click', e => { e.stopPropagation(); $('sdkDiffMenu').hidden = !$('sdkDiffMenu').hidden; });
for (const b of $('sdkDiffMenu').querySelectorAll('button')) on(b, 'click', e => { e.stopPropagation(); askDiff(b.dataset.diff); });
on(document, 'click', e => { if (!e.target.closest('.sdk-stat-diff')) closeDropdown(); });
on($('sdkConfirmNo'), 'click', () => { $('sdkConfirm').hidden = true; pendingDiff = null; });
on($('sdkConfirmOk'), 'click', () => {
  if ($('sdkNoAsk').checked) { try { localStorage.setItem(NOASK_KEY, '1'); } catch (e) {} }
  $('sdkConfirm').hidden = true;
  const d = pendingDiff; pendingDiff = null;
  if (d) startNew(d);
});
on($('sdkConfirm'), 'click', e => { if (e.target === $('sdkConfirm')) { $('sdkConfirm').hidden = true; pendingDiff = null; } });
on($('sdkHintPrev'), 'click', () => { if (hint && hint.step > 0) { hint.step--; showHint(); } });
on($('sdkHintNext'), 'click', () => { if (hint && hint.step < hint.steps.length - 1) { hint.step++; showHint(); } });
on($('sdkHintOk'), 'click', applyHint);
on($('sdkHintClose'), 'click', closeHint);

on(document, 'keydown', e => {
  if (!S) return;
  if (TB && TB.isOpen()) return;
  const t = e.target;
  if (t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.isContentEditable)) return;
  if (modalOpen()) { if (e.key === 'Escape') { closeMenu(); $('sdkConfirm').hidden = true; } return; }
  if (e.altKey) return;
  const k = e.key, code = e.keyCode;
  if ((e.ctrlKey || e.metaKey) && (k === 'z' || k === 'Z' || e.code === 'KeyZ')) { e.preventDefault(); doUndo(); return; }
  if (e.ctrlKey || e.metaKey) return;
  // 숫자는 물리 키(e.code)로 본다 — 한글 입력 모드에선 keyCode가 229로 와서 숫자를 못 알아본다
  const dm = /^(?:Digit|Numpad)([0-9])$/.exec(e.code || '');
  const dg = dm ? +dm[1] : (/^[0-9]$/.test(k) ? +k : -1);
  if (dg >= 1) { e.preventDefault(); inputNumber(dg); return; }
  if (dg === 0 || code === 8 || code === 46 || k === 'Backspace' || k === 'Delete') { e.preventDefault(); erase(); return; }
  if (code === 37) { e.preventDefault(); move('L'); return; }
  if (code === 38) { e.preventDefault(); move('U'); return; }
  if (code === 39) { e.preventDefault(); move('R'); return; }
  if (code === 40) { e.preventDefault(); move('D'); return; }
  if (k === 'n' || k === 'N' || k === ' ' || e.code === 'KeyN') { e.preventDefault(); toggleNotes(); return; }
  if (k === 'h' || k === 'H' || e.code === 'KeyH') { e.preventDefault(); useHint(); return; }
  if (k === 'p' || k === 'P' || k === 'Escape' || e.code === 'KeyP') {
    if (hint && k === 'Escape') { closeHint(); return; }
    e.preventDefault(); setPaused(!paused); return;
  }
  if (k === 'Enter' && hint) { e.preventDefault(); if (hint.step < hint.steps.length - 1) { hint.step++; showHint(); } else applyHint(); }
});

// 탭이 숨겨지면 자동 일시정지, 돌아오면 자동으로 풀린다
on(document, 'visibilitychange', () => {
  if (!S) return;
  if (document.hidden) {
    if (S.state === 'play' && !paused) { setPaused(true); autoPaused = true; }
    save();
  } else if (autoPaused) { autoPaused = false; setPaused(false); }
});
on(window, 'pagehide', () => save());

// ── 시작 ──────────────────────────────────────────────────
const saved = load();
if (saved) {
  S = saved;
  if (!Array.isArray(S.scored)) S.scored = [];
  acc = S.elapsed || 0; runStart = null;
  if (S.state === 'play') runTimer();
  root.classList.toggle('tipon', !S.touched);
  render();
  if (S.state === 'over') showOver();
} else {
  startNew('easy');
}
let saveTick = 0;
tickId = setInterval(() => {
  if (dead) return;
  renderTime();
  if (++saveTick % 20 === 0 && S && S.state === 'play' && !paused) save();   // 5초마다 경과 시간 저장
}, 250);
if (TB) TB.top('sudoku').then(list => { if (!dead) renderTop($('sdkTop'), list); });
else renderTop($('sdkTop'), []);

})();
</script>
