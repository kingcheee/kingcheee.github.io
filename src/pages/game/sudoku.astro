---
import BaseLayout from "../../layouts/BaseLayout.astro";
import GameBoard from "../../components/GameBoard.astro";
---

<BaseLayout title="스도쿠" sideBarActiveItemID="game">
  <div id="sdk">
    <!-- 보드 위 난이도 띠 (데스크톱) -->
    <div class="sdk-strip">
      <div class="sdk-strip-title">난이도:</div>
      <div class="sdk-strip-items">
        <button type="button" class="sdk-diffbtn" data-diff="easy">쉬움</button>
        <button type="button" class="sdk-diffbtn" data-diff="hard">어려움</button>
      </div>
    </div>

    <div class="sdk-flex">
      <!-- 통계 줄: 데스크톱은 오른쪽 패널 맨 위, 모바일은 보드 위 -->
      <div class="sdk-stats">
        <div class="sdk-stat sdk-score">
          <svg class="sdk-cup" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3.5h10v5.2a5 5 0 0 1-10 0z" /><path d="M7 5.5H4.2a3.3 3.3 0 0 0 3.3 4.3M17 5.5h2.8a3.3 3.3 0 0 1-3.3 4.3" fill="none" /><path d="M10.6 13.4h2.8v3.4h-2.8z" /><path d="M7.5 17.5h9v3h-9z" /></svg>
          <span id="sdkScore">0</span>
          <span id="sdkScoreAdd"></span>
        </div>
        <div class="sdk-stat sdk-stat-diff">
          <div class="sdk-label">난이도</div>
          <button type="button" id="sdkDiffLabel" class="sdk-difflabel"><span id="sdkDiffText">쉬움</span><svg viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" /></svg></button>
          <div id="sdkDiffMenu" class="sdk-dropdown" hidden>
            <button type="button" data-diff="easy">쉬움</button>
            <button type="button" data-diff="hard">어려움</button>
          </div>
        </div>
        <div class="sdk-stat">
          <div class="sdk-label">실수</div>
          <div class="sdk-val"><span id="sdkMis">0</span>/<span>3</span></div>
        </div>
        <div class="sdk-stat sdk-stat-time">
          <div>
            <div class="sdk-label">시간</div>
            <div class="sdk-val" id="sdkTime">00:00</div>
          </div>
          <button type="button" id="sdkPause" class="sdk-pausebtn" aria-label="일시정지">
            <svg class="ic-pause" viewBox="0 0 24 24"><rect x="7" y="6" width="3.4" height="12" rx="1.2" /><rect x="13.6" y="6" width="3.4" height="12" rx="1.2" /></svg>
            <svg class="ic-play" viewBox="0 0 24 24"><path d="M8.5 6.6v10.8a1 1 0 0 0 1.5.86l8.6-5.4a1 1 0 0 0 0-1.72L10 5.74a1 1 0 0 0-1.5.86z" /></svg>
          </button>
        </div>
      </div>

      <!-- 보드 -->
      <div class="sdk-gamewrap">
        <div id="sdkBoard" class="sdk-board"></div>
        <div id="sdkPauseOv" class="sdk-pauseov">
          <button type="button" class="sdk-bigplay" aria-label="계속하기">
            <svg viewBox="0 0 60 60"><circle cx="30" cy="30" r="30" /><path d="M39.1 32l-12.6 8.6a2.4 2.4 0 0 1-3.7-2V21.4a2.4 2.4 0 0 1 3.7-2l12.6 8.6a2.4 2.4 0 0 1 0 4z" /></svg>
          </button>
        </div>
        <div id="sdkTip" class="sdk-tip">셀을 선택한 후, 셀 안에 채울 숫자를 탭하세요</div>

        <!-- 게임 오버 -->
        <div id="sdkOver" class="sdk-layer" hidden>
          <div class="sdk-card">
            <div class="sdk-card-title">게임 오버</div>
            <div class="sdk-card-desc">3회 실수하면 게임이 종료됩니다</div>
            <button type="button" id="sdkSecond" class="sdk-mainbtn">두 번째 기회</button>
            <button type="button" id="sdkOverNew" class="sdk-linkbtn">새 게임</button>
          </div>
        </div>

        <!-- 승리 -->
        <div id="sdkWin" class="sdk-layer sdk-layer-win" hidden>
          <div class="sdk-card sdk-wincard">
            <div class="sdk-card-title">훌륭합니다!</div>
            <dl class="sdk-winstats">
              <div><dt>난이도</dt><dd id="sdkWinDiff">쉬움</dd></div>
              <div><dt>시간</dt><dd id="sdkWinTime">00:00</dd></div>
              <div><dt>점수</dt><dd id="sdkWinScore">0</dd></div>
              <div><dt>최고 점수</dt><dd id="sdkWinBest">0</dd></div>
            </dl>
            <p id="sdkWinNote" class="sdk-winnote"></p>
            <div id="sdkWinTopWrap" class="sdk-wintop" hidden>
              <div class="sdk-toptitle">어려움 TOP 5</div>
              <ol id="sdkWinTop" class="sdk-toplist"></ol>
            </div>
            <button type="button" id="sdkWinNew" class="sdk-mainbtn">새 게임</button>
          </div>
        </div>
      </div>

      <!-- 컨트롤 패널 -->
      <div class="sdk-newgame">
        <button type="button" id="sdkNewBtn" class="sdk-mainbtn">새 게임</button>
      </div>

      <div class="sdk-controls">
        <div class="sdk-tools">
          <button type="button" class="sdk-tool" data-act="undo">
            <span class="sdk-toolic"><svg viewBox="0 0 24 24"><path d="M9.2 4.6L5.4 8.7l3.8 4.1" /><path d="M5.8 8.7h7.4a6.2 6.2 0 1 1-6.2 6.2" /></svg></span>
            <span class="sdk-toollabel">실행 취소</span>
          </button>
          <button type="button" class="sdk-tool" data-act="erase">
            <span class="sdk-toolic"><svg viewBox="0 0 24 24"><path d="M13.9 4.9l5.2 5.2a1.6 1.6 0 0 1 0 2.3L11.3 20H7.6l-3.2-3.2a1.6 1.6 0 0 1 0-2.3l7.2-7.2z" /><path d="M8.3 9.5l6.2 6.2" /><path d="M14.5 20h5.5" /></svg></span>
            <span class="sdk-toollabel">지우기</span>
          </button>
          <button type="button" class="sdk-tool" data-act="notes">
            <span class="sdk-toolic"><svg viewBox="0 0 24 24"><path d="M15.6 4.6a2.3 2.3 0 0 1 3.3 3.3L8.6 18.2l-4.1 1 1-4.1z" /><path d="M13.8 6.4l3.3 3.3" /></svg><i id="sdkNoteBadge" class="sdk-badge sdk-badge-pill">OFF</i></span>
            <span class="sdk-toollabel">메모</span>
          </button>
          <button type="button" class="sdk-tool" data-act="hint">
            <span class="sdk-toolic"><svg viewBox="0 0 24 24"><path d="M9.4 17.2h5.2M10.2 20.2h3.6" /><path d="M12 3.4a6.1 6.1 0 0 0-3.4 11.2c.5.4.8.9.8 1.6v1h5.2v-1c0-.7.3-1.2.8-1.6A6.1 6.1 0 0 0 12 3.4z" /></svg><i id="sdkHintBadge" class="sdk-badge sdk-badge-dot">3</i></span>
            <span class="sdk-toollabel">힌트</span>
          </button>
        </div>
        <div class="sdk-numpad" id="sdkPad">
          <button type="button" data-n="1">1</button><button type="button" data-n="2">2</button><button type="button" data-n="3">3</button>
          <button type="button" data-n="4">4</button><button type="button" data-n="5">5</button><button type="button" data-n="6">6</button>
          <button type="button" data-n="7">7</button><button type="button" data-n="8">8</button><button type="button" data-n="9">9</button>
        </div>

        <!-- 스마트 힌트 캐러셀 (컨트롤 위를 덮는다) -->
        <div id="sdkHintBox" class="sdk-hintbox" hidden>
          <button type="button" id="sdkHintClose" class="sdk-hintclose" aria-label="닫기"><svg viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18" /></svg></button>
          <div id="sdkHintName" class="sdk-hintname"></div>
          <div id="sdkHintDesc" class="sdk-hintdesc"></div>
          <div class="sdk-hintnav">
            <button type="button" id="sdkHintPrev" class="sdk-hintarrow" aria-label="이전"><svg viewBox="0 0 24 24"><path d="M14.5 6l-6 6 6 6" /></svg></button>
            <div id="sdkHintDots" class="sdk-hintdots"></div>
            <button type="button" id="sdkHintNext" class="sdk-hintarrow" aria-label="다음"><svg viewBox="0 0 24 24"><path d="M9.5 6l6 6-6 6" /></svg></button>
            <button type="button" id="sdkHintOk" class="sdk-hintok" aria-label="확인"><svg viewBox="0 0 24 24"><path d="M5.5 12.5l4.2 4.2 8.8-9" /></svg></button>
          </div>
        </div>
      </div>
    </div>

    <!-- 새 게임 메뉴 -->
    <div id="sdkMenu" class="sdk-modal" hidden>
      <div class="sdk-menu">
        <div class="sdk-menu-head">새 게임</div>
        <div class="sdk-menu-sub">현재 게임 진행 상황이 사라집니다</div>
        <button type="button" class="sdk-menu-item" data-diff="easy"><span class="sdk-menu-ic"><svg viewBox="0 0 24 24"><rect x="4" y="4" width="16" height="16" rx="2" /><path d="M9.3 4v16M14.7 4v16M4 9.3h16M4 14.7h16" /></svg></span>쉬움</button>
        <button type="button" class="sdk-menu-item" data-diff="hard"><span class="sdk-menu-ic"><svg viewBox="0 0 24 24"><rect x="4" y="4" width="16" height="16" rx="2" /><path d="M9.3 4v16M14.7 4v16M4 9.3h16M4 14.7h16" /></svg></span>어려움</button>
        <button type="button" class="sdk-menu-item" data-act="restart"><span class="sdk-menu-ic"><svg viewBox="0 0 24 24"><path d="M19 12a7 7 0 1 1-2.1-5" /><path d="M17.5 3.5v4h-4" /></svg></span>다시 시작</button>
        <button type="button" id="sdkMenuCancel" class="sdk-menu-cancel">취소</button>
      </div>
    </div>

    <!-- 난이도 변경 확인 -->
    <div id="sdkConfirm" class="sdk-modal" hidden>
      <div class="sdk-menu">
        <div class="sdk-menu-head">새 게임 시작</div>
        <div class="sdk-menu-sub">현재 게임 진행 상황이 사라집니다</div>
        <label class="sdk-check"><input type="checkbox" id="sdkNoAsk" /> 다시 묻지 않기</label>
        <div class="sdk-confirm-btns">
          <button type="button" id="sdkConfirmNo" class="sdk-subbtn">취소</button>
          <button type="button" id="sdkConfirmOk" class="sdk-mainbtn">확인</button>
        </div>
      </div>
    </div>

    <!-- 어려움 TOP 5 -->
    <section class="sdk-board5">
      <div class="sdk-toptitle">어려움 TOP 5 <span>완료 시간</span></div>
      <ol id="sdkTop" class="sdk-toplist"></ol>
    </section>
  </div>
  <GameBoard />
</BaseLayout>

<style is:global>
  footer.footer { display: none; }

  #sdk {
    --bg: #FEFDFA; --panel: #F7F6F0; --line: #EAEAE2; --ink: #23281E;
    --green: #2F8A25; --bright: #55B93E; --pale: #EAF6E4;
    --red: #C4442A; --yellow: #D9A520;
    --thin: #D5D6C9;          /* 얇은 칸 선 (원본 #BFC6D4 역할) */
    --muted: #7A7F70;         /* 라벨 (원본 #6e7c8c 역할) */
    --ctl: #EEEEE6;           /* 도구·숫자 버튼 바탕 (원본 #eaeef4 역할) */
    --ctl-h: #E2E3D8;
    --hl-area: #EEF4E6;       /* 같은 행·열·블록 (원본 #e2ebf3) */
    --hl-same: #D3E9C8;       /* 같은 숫자 (원본 #c3d7ea) */
    --hl-sel: #BFE0AE;        /* 선택 셀 (원본 #bbdefb) */
    --hl-conf: #F6D9D0;       /* 충돌 (원본 #f7cfd6) */
    font-family: "Pretendard Variable", Pretendard, -apple-system, system-ui, sans-serif;
    color: var(--ink);
    width: min(852px, calc(100vw - 48px));
    max-width: 100%;
    margin: 0 auto;
    -webkit-tap-highlight-color: transparent;
    user-select: none;
    -webkit-user-select: none;
  }
  #sdk button { font-family: inherit; -webkit-tap-highlight-color: transparent; touch-action: manipulation; }
  #sdk [hidden] { display: none !important; }

  /* ── 난이도 띠 ───────────────────────── */
  #sdk .sdk-strip { display: flex; align-items: center; gap: 4px; min-height: 34px; margin: -6px 0 12px; font-size: 14px; }
  #sdk .sdk-strip-title { color: var(--muted); font-weight: 500; margin-right: 6px; }
  #sdk .sdk-strip-items { display: flex; gap: 2px; }
  #sdk .sdk-diffbtn { background: none; border: 0; padding: 6px 10px; border-radius: 6px; color: var(--muted); font-size: 14px; font-weight: 500; cursor: pointer; }
  #sdk .sdk-diffbtn:hover { color: var(--ink); background: var(--panel); }
  #sdk .sdk-diffbtn.active { color: var(--green); font-weight: 700; }

  /* ── 큰 틀: 모바일은 세로 쌓기 ─────────── */
  #sdk .sdk-flex { display: grid; grid-template-columns: 100%; grid-template-areas: "stats" "board" "controls" "newgame"; row-gap: 0; }
  #sdk .sdk-stats { grid-area: stats; }
  #sdk .sdk-gamewrap { grid-area: board; }
  #sdk .sdk-controls { grid-area: controls; }
  #sdk .sdk-newgame { grid-area: newgame; }

  @media (min-width: 801px) {
    #sdk .sdk-flex {
      grid-template-columns: minmax(250px, 500px) minmax(0, 1fr);
      grid-template-rows: auto auto auto 1fr;
      grid-template-areas: "board stats" "board newgame" "board controls" "board .";
      column-gap: 28px;
    }
  }
  @media (max-width: 800px) {
    #sdk .sdk-strip { display: none; }
  }

  /* ── 통계 줄 ─────────────────────────── */
  #sdk .sdk-stats { display: flex; justify-content: space-between; align-items: center; min-height: 40px; margin-bottom: 12px; position: relative; }
  #sdk .sdk-stat { position: relative; display: flex; flex-direction: column; }
  #sdk .sdk-label { color: var(--muted); font-size: 13px; font-weight: 500; letter-spacing: .22px; line-height: 1.23; margin-bottom: 1px; white-space: nowrap; }
  #sdk .sdk-val { font-size: 15px; font-weight: 600; line-height: 1.33; font-variant-numeric: tabular-nums; }
  #sdk .sdk-score { flex-direction: row; align-items: center; gap: 6px; font-size: 22px; font-weight: 700; font-variant-numeric: tabular-nums; }
  #sdk .sdk-cup { width: 22px; height: 22px; fill: var(--yellow); stroke: var(--yellow); stroke-width: 1.6; stroke-linejoin: round; }
  #sdk .sdk-cup path[fill="none"] { fill: none; }
  #sdkScoreAdd { position: absolute; left: 28px; top: -16px; font-size: 14px; font-weight: 700; color: var(--green); opacity: 0; white-space: nowrap; pointer-events: none; }
  #sdkScoreAdd.show { animation: sdkScoreUp 1s ease-out forwards; }
  @keyframes sdkScoreUp { 0% { opacity: 0; transform: translateY(6px); } 20% { opacity: 1; } 100% { opacity: 0; transform: translateY(-14px); } }

  #sdk .sdk-difflabel { display: flex; align-items: center; gap: 4px; background: none; border: 0; padding: 0; font-size: 15px; font-weight: 600; color: var(--ink); cursor: pointer; line-height: 1.33; }
  #sdk .sdk-difflabel svg { width: 10px; height: 6px; fill: none; stroke: var(--muted); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  #sdk .sdk-dropdown { position: absolute; top: calc(100% + 6px); left: -12px; z-index: 30; background: #fff; border-radius: 8px; box-shadow: 0 4px 18px rgba(35, 40, 30, .16); padding: 6px 0; min-width: 120px; }
  #sdk .sdk-dropdown button { display: block; width: 100%; text-align: left; background: none; border: 0; padding: 8px 16px; font-size: 15px; color: var(--ink); cursor: pointer; }
  #sdk .sdk-dropdown button:hover { background: var(--pale); }
  #sdk .sdk-dropdown button.active { color: var(--green); font-weight: 700; }
  #sdk .sdk-stat-time { flex-direction: row; align-items: center; gap: 8px; }
  #sdk .sdk-pausebtn { width: 34px; height: 34px; border-radius: 50%; border: 0; background: var(--ctl); display: flex; align-items: center; justify-content: center; cursor: pointer; padding: 0; }
  #sdk .sdk-pausebtn:hover { background: var(--ctl-h); }
  #sdk .sdk-pausebtn svg { width: 20px; height: 20px; fill: var(--green); }
  #sdk .sdk-pausebtn .ic-play { display: none; }
  #sdk.paused .sdk-pausebtn .ic-play { display: block; }
  #sdk.paused .sdk-pausebtn .ic-pause { display: none; }

  /* ── 보드 ─────────────────────────────── */
  #sdk .sdk-gamewrap { position: relative; width: 100%; max-width: 500px; justify-self: center; align-self: start; }
  #sdk .sdk-board {
    container-type: inline-size;
    display: grid; grid-template-columns: repeat(9, 1fr); grid-template-rows: repeat(9, 1fr);
    aspect-ratio: 1 / 1; width: 100%;
    border: 2px solid var(--ink); background: var(--bg);
    touch-action: manipulation;
  }
  #sdk .c {
    position: relative; box-sizing: border-box;
    border-right: 1px solid var(--thin); border-bottom: 1px solid var(--thin);
    display: flex; align-items: center; justify-content: center;
    cursor: pointer; background: var(--bg);
    transition: background-color .08s;
  }
  #sdk .c.br { border-right: 2px solid var(--ink); }
  #sdk .c.bb { border-bottom: 2px solid var(--ink); }
  #sdk .c.er { border-right: 0; }
  #sdk .c.eb { border-bottom: 0; }
  #sdk .c .v { font-size: 6.6cqw; font-weight: 400; line-height: 1; color: var(--ink); font-variant-numeric: tabular-nums; }
  #sdk .c.user .v { color: var(--green); }
  #sdk .c.bad .v { color: var(--red); }
  #sdk .c .nt { position: absolute; inset: 0; display: grid; grid-template-columns: repeat(3, 1fr); grid-template-rows: repeat(3, 1fr); padding: 1px 2px; }
  #sdk .c .nt span { display: flex; align-items: center; justify-content: center; font-size: 2.65cqw; line-height: 1; color: var(--muted); font-weight: 500; }
  #sdk .c .nt span.hot { color: var(--green); font-weight: 800; }
  #sdk .c.area { background: var(--hl-area); }
  #sdk .c.same { background: var(--hl-same); }
  #sdk .c.conf { background: var(--hl-conf); }
  #sdk .c.sel { background: var(--hl-sel); }
  #sdk .c.sh-area { background: var(--hl-same); }
  #sdk .c.sh-target { background: var(--hl-sel); box-shadow: inset 0 0 0 2px var(--green); }
  #sdk .c.wave { animation: sdkWave .5s ease-out; }
  @keyframes sdkWave { 0% { background-color: var(--bg); } 35% { background-color: var(--hl-sel); } 100% { background-color: var(--bg); } }
  #sdk .c.clear { animation: sdkClear .55s ease-out forwards; }
  #sdk .c.clear .v, #sdk .c.clear .nt { animation: sdkFade .55s ease-out forwards; }
  @keyframes sdkClear { 0% { background-color: var(--hl-sel); } 100% { background-color: var(--bg); } }
  @keyframes sdkFade { 0% { opacity: 1; } 100% { opacity: 0; } }
  #sdk.paused .c .v, #sdk.paused .c .nt { visibility: hidden; }
  #sdk.paused .c { background: var(--bg) !important; }

  #sdk .sdk-pauseov { position: absolute; inset: 0; display: none; align-items: center; justify-content: center; z-index: 10; cursor: pointer; }
  #sdk.paused .sdk-pauseov { display: flex; }
  #sdk .sdk-bigplay { background: none; border: 0; padding: 0; cursor: pointer; width: 76px; height: 76px; }
  #sdk .sdk-bigplay svg { width: 100%; height: 100%; }
  #sdk .sdk-bigplay circle { fill: var(--green); }
  #sdk .sdk-bigplay path { fill: #fff; }

  #sdk .sdk-tip {
    position: absolute; left: 20px; right: 20px; bottom: 20px; z-index: 5;
    background: var(--green); color: #fff; border-radius: 5px; padding: 15px 24px;
    font-size: 14px; line-height: 1.43; text-align: center; pointer-events: none;
    box-shadow: 0 5px 8px rgba(35, 40, 30, .25); opacity: 0; transition: opacity .3s ease-in-out;
  }
  #sdk.tipon .sdk-tip { opacity: 1; }
  #sdk.paused .sdk-tip { opacity: 0; }

  /* 보드 위 레이어 (게임 오버·승리) */
  #sdk .sdk-layer { position: absolute; inset: -6px; z-index: 40; display: flex; align-items: center; justify-content: center; background: rgba(35, 40, 30, .62); border-radius: 6px; padding: 12px; }
  #sdk .sdk-layer-win { background: rgba(254, 253, 250, .9); align-items: flex-start; overflow: auto; }
  #sdk .sdk-card { background: var(--bg); border-radius: 10px; width: min(320px, 100%); padding: 26px 22px 18px; text-align: center; box-shadow: 0 8px 28px rgba(35, 40, 30, .2); }
  #sdk .sdk-card-title { font-size: 24px; font-weight: 700; margin-bottom: 8px; }
  #sdk .sdk-card-desc { color: var(--muted); font-size: 15px; margin-bottom: 22px; }
  #sdk .sdk-linkbtn { margin-top: 14px; background: none; border: 0; color: var(--green); font-size: 15px; font-weight: 600; cursor: pointer; padding: 6px 10px; }
  #sdk .sdk-wincard { margin-top: 6%; }
  #sdk .sdk-winstats { margin: 18px 0 8px; display: grid; gap: 0; }
  #sdk .sdk-winstats > div { display: flex; justify-content: space-between; padding: 9px 4px; border-bottom: 1px solid var(--line); font-size: 15px; }
  #sdk .sdk-winstats dt { color: var(--muted); font-weight: 500; }
  #sdk .sdk-winstats dd { margin: 0; font-weight: 700; font-variant-numeric: tabular-nums; }
  #sdk .sdk-winnote { min-height: 0; margin: 6px 0 0; font-size: 13px; color: var(--green); font-weight: 600; }
  #sdk .sdk-winnote:empty { display: none; }
  #sdk .sdk-wintop { text-align: left; margin: 14px 0 4px; }
  #sdk .sdk-wincard .sdk-mainbtn { margin-top: 16px; }

  /* ── 큰 버튼 ─────────────────────────── */
