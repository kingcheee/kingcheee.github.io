---
import "pretendard/dist/web/variable/pretendardvariable-dynamic-subset.css";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { ViewTransitions } from "astro:transitions";

import { SITE_TITLE, SITE_DESCRIPTION, TRANSITION_API } from "../config";

const {
  image,
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  sideBarActiveItemID,
  ogType,
} = Astro.props;
---

<!doctype html>
<html lang="ko" data-theme="turtle">
  <head>
    <BaseHead title={title} description={description} image={image} , ogType={ogType} />
    {TRANSITION_API && <ViewTransitions />}
  </head>
  <body class="bg-base-100">
    <Header activeItemID={sideBarActiveItemID} />
    <div class="md:flex md:justify-center">
      <main class="p-6 pt-10 lg:max-w-[900px] max-w-[100vw]">
        <slot />
      </main>
    </div>
    <Footer />
    <script>
      // ViewTransitions(클라이언트 라우팅)로 들어온 페이지의 <video src>는 DOMParser의 inert 문서에서
      // 파싱되는 바람에 error.code 4(SRC_NOT_SUPPORTED)·networkState 3 상태로 바뀌어 들어온다
      // (2026-10-07 실측 — 주소로 직접 열면 정상, 목록·이전/다음 링크로 들어오면 0:00 빈 플레이어).
      // 페이지 로드마다 그런 요소만 load()를 다시 불러 복구한다. 처음 전체 로드 때는 해당 없음.
      document.addEventListener("astro:page-load", () => {
        for (const media of document.querySelectorAll("video, audio")) {
          if (media.error || media.networkState === HTMLMediaElement.NETWORK_NO_SOURCE) media.load();
        }
      });
    </script>
  </body>
</html>
