---
import { type BlogSchema } from "../content/config";
import BaseLayout from "./BaseLayout.astro";
import TableOfContents from "../components/TableOfContents.astro";
import dayjs from "dayjs";
import localizedFormat from "dayjs/plugin/localizedFormat";

export interface Props extends BlogSchema {
  headings?: { depth: number; slug: string; text: string }[];
}

const { title, description, pubDate, updatedDate, heroImage, badge, tags = [], headings = [] } = Astro.props;
dayjs.extend(localizedFormat);
const displayDate = dayjs(pubDate).format("ll")
import { Image } from "astro:assets";
---

<BaseLayout title={title} description={description} image={heroImage}, ogType="article">
  <main class="md:flex md:justify-center xl:gap-8 xl:translate-x-4">
    <article class="prose prose-lg max-w-[750px] xl:max-w-[840px] prose-img:mx-auto">
      {heroImage && <Image width={750} height={422} format="webp" src={heroImage} alt={title} class="hero-img w-full h-40 object-cover mb-6" />}
      <h1 class="title my-2 text-4xl font-bold">{title}</h1>
      {pubDate && <time>{displayDate}</time>}
      <br />
      {badge && <div class="badge badge-secondary my-1">{badge}</div>}
      {
        tags &&
          tags.map((tag) => (
            <a href={`/blog/tag/${tag}`} class="badge badge-outline ml-2 no-underline">
              {tag}
            </a>
          ))
      }
      {
        updatedDate && (
          <div>
            {" "}
            Last updated on <time>{updatedDate}</time>{" "}
          </div>
        )
      }
      <div class="divider my-2"></div>
      <slot />
    </article>

    <TableOfContents headings={headings} title={title} />
  </main>

  <!-- 본문 사진: 사진과 글을 한 행으로 묶는다 — 사진 옆엔 항상 글이 있고, 글은 사진 세로 중앙에 (hero 제외, 2026-08-17).
       마크다운 규칙: `![...](...) <span>글...</span>` 한 문단 — span 없이 볼드를 쓰면 flex가 쪼갠다. -->
  <style is:global>
    /* BaseLayout의 컨테이너 캡(900px)을 글 페이지에서만 확장 — 본문 840 + 간격 32 + 목차 208 + 패딩 48 (2026-08-17 TOC) */
    @media (min-width: 1280px) {
      main:has(article.prose) {
        max-width: 1140px;
      }
    }
    article.prose p:has(> img:not(.hero-img)) {
      display: flex;
      gap: 1.25rem;
      align-items: center;
    }
    article.prose p:has(> img:not(.hero-img)) img {
      width: 12rem;
      height: 12rem;
      object-fit: cover;
      border-radius: 0.75rem;
      flex: 0 0 auto;
      margin: 0;
    }
    /* 1:1이 아닌 이미지(코드 스니펫 code-*, 가로형 사진 wide-*)는 크롭도 축소도 하지
       않는다 — 옆에 글을 붙이지 않고 본문 폭 전체를 쓰고, 글은 그 아래로 내린다.
       (2026-08-20 사용자 지시: "1대1이 아닌 코드베이스나 사진들은 사이즈 확대하자".
       11rem 썸네일로는 모바일에서 코드가 아예 안 읽혔다.) 사진은 지금까지대로 1:1. */
    article.prose p:has(> img[src*="/code-"]),
    article.prose p:has(> img[src*="/wide-"]) {
      display: block;
    }
    /* :not(.hero-img)는 장식이 아니라 특정도용이다 — 이게 없으면 뒤에 오는
       @media(max-width:640px)의 8.5rem 정사각 규칙과 특정도가 같아져 모바일에서 진다. */
    article.prose p:has(> img[src*="/code-"]) img:not(.hero-img),
    article.prose p:has(> img[src*="/wide-"]) img:not(.hero-img) {
      width: 100%;
      height: auto;
      object-fit: contain;
      margin: 0 0 0.75rem;
    }
    article.prose p:has(> img[src*="/code-"]) span,
    article.prose p:has(> img[src*="/wide-"]) span {
      display: block;
    }
    /* 등장 순서대로 사진 좌/우 교대 (6장까지) — 홀수번째 사진 왼쪽, 짝수번째 오른쪽 */
    article.prose p:has(> img) ~ p:has(> img) {
      flex-direction: row-reverse;
    }
    article.prose p:has(> img) ~ p:has(> img) ~ p:has(> img) {
      flex-direction: row;
    }
    article.prose p:has(> img) ~ p:has(> img) ~ p:has(> img) ~ p:has(> img) {
      flex-direction: row-reverse;
    }
    article.prose p:has(> img) ~ p:has(> img) ~ p:has(> img) ~ p:has(> img) ~ p:has(> img) {
      flex-direction: row;
    }
    article.prose p:has(> img) ~ p:has(> img) ~ p:has(> img) ~ p:has(> img) ~ p:has(> img) ~ p:has(> img) {
      flex-direction: row-reverse;
    }
    @media (max-width: 640px) {
      article.prose p:has(> img:not(.hero-img)) {
        gap: 1rem;
      }
      article.prose p:has(> img:not(.hero-img)) img {
        width: 8.5rem;
        height: 8.5rem;
      }
      /* 모바일에서도 전폭 — 위 규칙이 그대로 적용된다. 따로 줄이지 않는다. */
    }
    /* 라이트박스 — 본문 이미지를 클릭하면 원본 크기로 (2026-08-17) */
    article.prose img {
      cursor: zoom-in;
    }
    .lightbox {
      position: fixed;
      inset: 0;
      z-index: 50;
      background: rgba(0, 0, 0, 0.78);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 2rem;
      cursor: zoom-out;
    }
    .lightbox img {
      max-width: min(92vw, 960px);
      max-height: 88vh;
      border-radius: 0.75rem;
    }
  </style>

  <!-- 라이트박스: 이미지 클릭 → 오버레이에 원본 크기(자연 크기 이상으로 키우지 않는다), 클릭/Esc로 닫기 -->
  <script is:inline data-astro-rerun>
    function initLightbox() {
      document.querySelectorAll("article.prose img:not([data-lightbox])").forEach((img) => {
        img.dataset.lightbox = "1";
        img.addEventListener("click", () => {
          const overlay = document.createElement("div");
          overlay.className = "lightbox";
          const big = document.createElement("img");
          big.src = img.src;
          big.alt = img.alt;
          overlay.appendChild(big);
          const close = () => {
            overlay.remove();
            document.removeEventListener("keydown", onKey);
          };
          const onKey = (e) => {
            if (e.key === "Escape") close();
          };
          overlay.addEventListener("click", close);
          document.addEventListener("keydown", onKey);
          document.body.appendChild(overlay);
        });
      });
    }
    initLightbox();
    document.addEventListener("astro:page-load", initLightbox);
  </script>

  <!-- ```mermaid 코드블록을 브라우저에서 다이어그램으로 렌더링 (CDN, 블록 있을 때만 로드) -->
  <script is:inline type="module" data-astro-rerun>
    async function renderMermaid() {
      const nodes = [];
      document.querySelectorAll('pre[data-language="mermaid"]').forEach((pre) => nodes.push(pre));
      document.querySelectorAll("pre > code.language-mermaid").forEach((code) => nodes.push(code.parentElement));
      const targets = [...new Set(nodes)].filter((el) => el && !el.dataset.mermaidDone);
      if (!targets.length) return;
      const { default: mermaid } = await import("https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs");
      mermaid.initialize({ startOnLoad: false, theme: "neutral" });
      targets.forEach((pre) => {
        const container = document.createElement("pre");
        container.className = "mermaid not-prose";
        container.textContent = pre.textContent;
        container.dataset.mermaidDone = "1";
        pre.replaceWith(container);
      });
      await mermaid.run({ querySelector: ".mermaid" });
    }
    renderMermaid();
    document.addEventListener("astro:page-load", renderMermaid);
  </script>
</BaseLayout>
