---
import { type BlogSchema } from "../content/config";
import BaseLayout from "./BaseLayout.astro";
import dayjs from "dayjs";
import localizedFormat from "dayjs/plugin/localizedFormat";

export interface Props extends BlogSchema {}

const { title, description, pubDate, updatedDate, heroImage, badge, tags = [] } = Astro.props;
dayjs.extend(localizedFormat);
const displayDate = dayjs(pubDate).format("ll")
import { Image } from "astro:assets";
---

<BaseLayout title={title} description={description} image={heroImage}, ogType="article">
  <main class="md:flex md:justify-center">
    <article class="prose prose-lg max-w-[750px] prose-img:mx-auto">
      {heroImage && <Image width={750} height={422} format="webp" src={heroImage} alt={title} class="w-full mb-6" />}
      <h1 class="title my-2 text-4xl font-bold">{title}</h1>
      {pubDate && <time>{displayDate}</time>}
      <br />
      {badge && <div class="badge badge-secondary my-1">{badge}</div>}
      {
        tags &&
          tags.map((tag) => (
            <a href={`/blog/tag/${tag}`} class="badge badge-outline ml-2 no-underline">
              {tag}
            </a>
          ))
      }
      {
        updatedDate && (
          <div>
            {" "}
            Last updated on <time>{updatedDate}</time>{" "}
          </div>
        )
      }
      <div class="divider my-2"></div>
      <slot />
    </article>
  </main>

  <!-- ```mermaid 코드블록을 브라우저에서 다이어그램으로 렌더링 (CDN, 블록 있을 때만 로드) -->
  <script is:inline type="module" data-astro-rerun>
    async function renderMermaid() {
      const nodes = [];
      document.querySelectorAll('pre[data-language="mermaid"]').forEach((pre) => nodes.push(pre));
      document.querySelectorAll("pre > code.language-mermaid").forEach((code) => nodes.push(code.parentElement));
      const targets = [...new Set(nodes)].filter((el) => el && !el.dataset.mermaidDone);
      if (!targets.length) return;
      const { default: mermaid } = await import("https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs");
      mermaid.initialize({ startOnLoad: false, theme: "neutral" });
      targets.forEach((pre) => {
        const container = document.createElement("pre");
        container.className = "mermaid not-prose";
        container.textContent = pre.textContent;
        container.dataset.mermaidDone = "1";
        pre.replaceWith(container);
      });
      await mermaid.run({ querySelector: ".mermaid" });
    }
    renderMermaid();
    document.addEventListener("astro:page-load", renderMermaid);
  </script>
</BaseLayout>
